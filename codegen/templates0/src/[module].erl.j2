%%% % @format
-module(~J< namespace.module >.).
-moduledoc """
~J< namespace.doc >.
~J{ if namespace.example }.

```erlang
~J< namespace.example >.
```
~J{ endif }.
""".
-moduledoc #{author => ["Andrew Bennett <potatosaladx@gmail.com>"]}.
-moduledoc #{created => "2015-12-28", modified => "2026-10-26"}.
-moduledoc #{copyright => "Andrew Bennett"}.
-compile(warn_missing_spec_all).

%% ~J< namespace.title >. API
-export([
~J{ for function in namespace.public_functions }.
    ~J< function.atom >./~J< function.arity >.~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).
~J{ if namespace.deprecated_functions }.

-deprecated([
~J{ for function in namespace.deprecated_functions }.
    {~J< function.atom >., ~J< function.arity >., "~J< function.deprecated | replace('"', '\\"') >."}~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).
~J{ endif }.
~J{ if namespace.state_c_type }.

%% Types

-doc """
An opaque native `~J< namespace.state_c_type >.`.

Operations never modify a state: each returns a new one, so earlier states
remain valid and can be reused or shared between processes. States cannot be
serialized; they exist only within the running VM.
""".
-type state() :: libsodium_nif:~J< namespace.state_c_type >.().

-export_type([
    state/0
]).
~J{ endif }.

%%%=============================================================================
%%% ~J< namespace.title >. API functions
%%%=============================================================================
~J{ for function in namespace.public_functions }.

-doc """
~J< function.doc >.
""".
~J{ if function.deprecated }.
-doc #{deprecated => "~J< function.deprecated | replace('"', '\\"') >."}.
~J{ endif }.
-spec ~J< function.spec >..
~J< function.atom >.(~J< function.params | join(', ') >.) ->
    ~J< function.body >..
~J{ endfor }.
