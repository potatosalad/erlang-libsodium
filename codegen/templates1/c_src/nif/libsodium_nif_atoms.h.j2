#ifndef LIBSODIUM_NIF_ATOMS_H
#define LIBSODIUM_NIF_ATOMS_H

#include "erl_nif_trampoline.h"

#ifdef __cplusplus
extern "C" {
#endif

/* Type Definitions */

typedef struct libsodium_nif_atom_table_s libsodium_nif_atom_table_t;

struct libsodium_nif_atom_table_s {
    /* clang-format off */ //-
{% for atom in ctx.nif.atoms_list %}
    ERL_NIF_TERM ATOM_{{ atom.name }};
{% endfor %}
    /* clang-format on */ //-
};

/* Global Variables */

extern libsodium_nif_atom_table_t *libsodium_nif_atom_table;

#define ATOM(Id) libsodium_nif_atom_table->ATOM_##Id

/* Function Declarations */

extern void libsodium_nif_make_atoms(ErlNifEnv *env);

#ifdef __cplusplus
}
#endif

#endif
