%%% % @format
{application, libsodium, [
    {description, "libsodium NIF for Erlang and Elixir"},
    {vsn, "3.0.0"},
    {id, "git"},
    {registered, [libsodium_sup]},
    {mod, {libsodium_app, []}},
    {applications, [
        kernel,
        stdlib
    ]},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/potatosalad/erlang-libsodium"}]},
    {exclude_paths, ["c_src/env.mk", "c_deps/libsodium/.git"]},
    {exclude_patterns, ["\\.d$", "\\.o$", "\\.pyc$", "(^|/)__pycache__(/|$)"]},
    {files, [
        "src",
        "c_src",
        "c_deps/libsodium",
        "guides",
        "Makefile",
        "erlang.mk",
        "rebar.config",
        "rebar.lock",
        "ex_doc.config",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]}
]}.
